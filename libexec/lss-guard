#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2025-2026 VectoDE
#
# SPDX-License-Identifier: MIT

# lss guard: keeps a server at the state lss set up. Installed by the guard module as /usr/local/lib/lss/guard and
# run daily by lss-guard.timer. Settings come from /etc/lss/guard.conf (KEY=value lines, parsed, never sourced).
#
# Checks: lss verify of every installed module (failed modules and files changed outside lss are configured again
# when GUARD_AUTOFIX=true), failed systemd units, disk space, pending security updates, vulnerable packages (debsecan
# on Debian, dnf updateinfo on the RHEL family), failed SSH logins and active bans, the results of the daily AIDE,
# rkhunter and ClamAV runs, the Lynis hardening index, certificates that expire soon, HIGH and CRITICAL vulnerabilities
# in the container images of Docker and Podman (Trivy), the age of the last backup and a weekly restore test (restic).
# The numbers of findings, fixes and notes also go to the node exporter for Prometheus (lss_guard_*).
# Every finding goes to the journal (identifier lss-guard); a summary goes to the webhook and the e-mail address.
# Notes (logins, bans) are part of the summary but do not make the run fail.
set -Eeuo pipefail
shopt -s inherit_errexit

CONF=${LSS_GUARD_CONF:-/etc/lss/guard.conf}
LSS=${LSS_GUARD_LSS:-/usr/local/sbin/lss}
STATE_DIR=${LSS_STATE_DIR:-/var/lib/lss}
OS_RELEASE=${LSS_OS_RELEASE:-/etc/os-release}
TLS_DIR=${LSS_TLS_DIR:-/etc/lss/tls}
# Installed by the docker and podman modules (lib/container.sh).
TRIVY=${LSS_GUARD_TRIVY:-/usr/local/bin/trivy}
TRIVY_CACHE=${LSS_GUARD_TRIVY_CACHE:-/var/cache/lss-trivy}
# Installed by the restic module (libexec/lss-backup), with its state next to it.
BACKUP=${LSS_GUARD_BACKUP:-/usr/local/lib/lss/backup}
BACKUP_STATE=${LSS_BACKUP_STATE:-${STATE_DIR}/restic}
# The node exporter's textfile collector (lib/monitoring.sh); the guard's metrics go there when it exists.
TEXTFILE_DIR=${LSS_TEXTFILE_DIR:-/var/lib/prometheus/node-exporter}
# A restore test every week, a little earlier so a daily run at the same time does not slip to the next day.
RESTORE_TEST_INTERVAL=$((7 * 86400 - 3600))
# Global also when the script is sourced inside a function (the unit tests).
declare -ga FINDINGS=() FIXED=() NOTES=()

setting() {
	local key=$1 default=${2-} line
	if [[ -r ${CONF} ]]; then
		while IFS= read -r line || [[ -n ${line} ]]; do
			if [[ ${line} == "${key}="* ]]; then
				printf '%s' "${line#*=}"
				return 0
			fi
		done <"${CONF}"
	fi
	printf '%s' "${default}"
}

# Findings can quote text that local users control (file names, log lines). Control characters are replaced, so such
# text cannot add lines to the summary, end the mail early or forge journal entries.
clean() {
	local text=$1
	printf '%s' "${text//[[:cntrl:]]/?}"
	return
}

finding() {
	local text
	text=$(clean "$1")
	FINDINGS+=("${text}")
	logger -t lss-guard -p auth.warning -- "${text}"
	return
}

note() {
	local text
	text=$(clean "$1")
	NOTES+=("${text}")
	logger -t lss-guard -p auth.info -- "${text}"
	return
}

check_modules() {
	local output name failed=() drifted=()
	output=$("${LSS}" --no-color verify 2>&1) || true
	while read -r name; do failed+=("${name}"); done < <(sed -nE 's/^ERROR +([a-z0-9-]+): not working$/\1/p' <<<"${output}")
	while read -r name; do drifted+=("${name}"); done < <(sed -nE 's/^WARN +([a-z0-9-]+): changed outside lss.*/\1/p' <<<"${output}")
	for name in "${failed[@]}" "${drifted[@]}"; do
		[[ -n ${name} ]] || continue
		if [[ $(setting GUARD_AUTOFIX true) == true ]] && "${LSS}" --yes --no-color configure "${name}" >/dev/null 2>&1; then
			FIXED+=("${name}")
			logger -t lss-guard -p auth.notice -- "Restored module ${name}"
		else
			finding "Module ${name} is not in the state lss set up (lss verify ${name})."
		fi
	done
	return
}

check_units() {
	local unit
	while read -r unit; do
		if [[ -n ${unit} ]]; then
			finding "Service ${unit} has failed."
		fi
	done < <(systemctl --failed --no-legend --plain 2>/dev/null | awk '{ print $1 }')
	return
}

check_disks() {
	local limit use mount
	limit=$(setting GUARD_DISK_THRESHOLD 90)
	while read -r use mount; do
		use=${use%\%}
		[[ ${use} =~ ^[0-9]+$ ]] || continue
		if ((use >= limit)); then
			finding "File system ${mount} is ${use} % full."
		fi
	done < <(df --output=pcent,target -x tmpfs -x devtmpfs -x overlay -x squashfs 2>/dev/null | tail -n +2)
	return
}

check_updates() {
	local count=0
	if command -v apt-get >/dev/null 2>&1; then
		count=$(apt-get -s -o Debug::NoLocking=true dist-upgrade 2>/dev/null | grep -c '^Inst .*-security' || true)
	elif command -v dnf >/dev/null 2>&1; then
		count=$(dnf -q updateinfo list --security 2>/dev/null | grep -c . || true)
	fi
	if ((count > 0)); then
		finding "${count} security update(s) are not installed yet."
	fi
	if [[ -f /run/reboot-required ]] || { command -v needs-restarting >/dev/null 2>&1 && ! needs-restarting --reboothint >/dev/null 2>&1; }; then
		finding "A reboot is pending to activate installed updates."
	fi
	return
}

# Failed SSH logins of the last 24 hours (a finding above GUARD_LOGIN_THRESHOLD, with the busiest sources) and the
# successful logins (a note, so an unexpected one stands out).
check_logins() {
	local threshold log failed count sources accepted
	threshold=$(setting GUARD_LOGIN_THRESHOLD 50)
	# _COMM and _UID are set by journald itself; a syslog identifier (-t sshd) could be forged with logger.
	log=$(journalctl --since -24h --no-pager -o cat _COMM=sshd _COMM=sshd-session _UID=0 2>/dev/null) || return 0
	failed=$(grep -E 'Failed (password|publickey|keyboard-interactive)|Invalid user|maximum authentication attempts' <<<"${log}" || true)
	count=0
	[[ -z ${failed} ]] || count=$(wc -l <<<"${failed}")
	if ((count > threshold)); then
		sources=$(grep -oE 'from [0-9a-fA-F.:]+' <<<"${failed}" | awk '{ print $2 }' | sort | uniq -c | sort -rn |
			head -n 3 | awk '{ printf "%s%s (%s)", sep, $2, $1; sep = ", " }')
		finding "${count} failed SSH logins in the last 24 hours, most from ${sources:-unknown sources}."
	fi
	accepted=$(grep -oE 'Accepted [a-z-]+ for [^ ]+ from [0-9a-fA-F.:]+' <<<"${log}" | awk '{ print $4 " from " $6 }' |
		sort | uniq -c | sort -rn | awk '{ printf "%s%s %s %s (%s)", sep, $2, $3, $4, $1; sep = ", " }' || true)
	if [[ -n ${accepted} ]]; then
		note "SSH logins in the last 24 hours: ${accepted}."
	fi
	return
}

# Addresses that fail2ban or CrowdSec block right now.
check_bans() {
	local count
	if command -v fail2ban-client >/dev/null 2>&1; then
		count=$(fail2ban-client banned 2>/dev/null | grep -oE "'([0-9]{1,3}\.){3}[0-9]{1,3}'|'[0-9a-fA-F]*:[0-9a-fA-F:]+'" |
			wc -l || true)
		if ((count > 0)); then
			note "fail2ban currently bans ${count} address(es)."
		fi
	fi
	if command -v cscli >/dev/null 2>&1; then
		count=$(cscli decisions list -o raw 2>/dev/null | tail -n +2 | grep -c . || true)
		if ((count > 0)); then
			note "CrowdSec currently blocks ${count} address(es)."
		fi
	fi
	return
}

# Vulnerabilities in installed packages: debsecan on Debian (Ubuntu is covered by the security updates check), the
# advisories of severity Critical and Important on the RHEL family.
check_vulnerabilities() {
	local codename all fixed count
	if command -v debsecan >/dev/null 2>&1; then
		codename=$(sed -n 's/^VERSION_CODENAME=//p' "${OS_RELEASE}" 2>/dev/null | tr -d '"')
		all=$(debsecan --suite "${codename}" --format summary 2>/dev/null | grep -c 'high urgency' || true)
		fixed=$(debsecan --suite "${codename}" --only-fixed --format summary 2>/dev/null | grep -c 'high urgency' || true)
		if ((fixed > 0)); then
			finding "${fixed} high-urgency vulnerabilities in installed packages have a fix: install the security updates."
		fi
		if ((all > fixed)); then
			note "$((all - fixed)) high-urgency vulnerabilities in installed packages have no fix yet (debsecan)."
		fi
	elif command -v dnf >/dev/null 2>&1; then
		count=$(dnf -q updateinfo list --security --sec-severity Critical --sec-severity Important 2>/dev/null |
			grep -c . || true)
		if ((count > 0)); then
			finding "${count} critical or important security advisories apply (dnf updateinfo list --security)."
		fi
	fi
	return
}

# scan_run UNIT: prints "STATUS EPOCH INVOCATION" of the last run of UNIT.service; nothing when it never ran.
scan_run() {
	local unit=$1 status exited invocation epoch
	systemctl cat "${unit}.service" >/dev/null 2>&1 || return 0
	exited=$(systemctl show -p ExecMainExitTimestamp --value "${unit}.service" 2>/dev/null || true)
	[[ -n ${exited} && ${exited} != n/a ]] || return 0
	status=$(systemctl show -p ExecMainStatus --value "${unit}.service" 2>/dev/null || true)
	invocation=$(systemctl show -p InvocationID --value "${unit}.service" 2>/dev/null || true)
	epoch=$(date -d "${exited}" +%s 2>/dev/null || echo 0)
	printf '%s %s %s\n' "${status:-0}" "${epoch}" "${invocation:--}"
	return
}

# The daily scanners report what they find through their exit status, which their units accept as success: AIDE 1-7
# for added, removed or changed files, rkhunter 1 for warnings, clamscan 1 for infected files.
check_scanners() {
	local entry unit label run status epoch invocation output when count detail
	for entry in lss-aide-check:AIDE lss-rkhunter:rkhunter lss-clamscan:ClamAV; do
		unit=${entry%%:*}
		label=${entry#*:}
		run=$(scan_run "${unit}")
		[[ -n ${run} ]] || continue
		read -r status epoch invocation <<<"${run}"
		when=$(date -d "@${epoch}" '+%Y-%m-%d %H:%M' 2>/dev/null || echo unknown)
		if ((epoch < $(date +%s) - 2 * 86400)); then
			finding "The daily ${label} check has not run since ${when} (systemctl status ${unit}.timer)."
		fi
		if [[ ! ${status} =~ ^[0-9]+$ ]] || ((status == 0)); then
			continue
		fi
		output=''
		if [[ ${invocation} != - ]]; then
			output=$(journalctl --no-pager -o cat "_SYSTEMD_INVOCATION_ID=${invocation}" 2>/dev/null || true)
		fi
		case ${label} in
		AIDE)
			detail=$(awk -F: '/^ *(Added|Removed|Changed) entries/ { n = $2; gsub(/[^0-9]/, "", n); split($1, w, " "); printf "%s%s %s", sep, n, tolower(w[1]); sep = ", " }' <<<"${output}")
			finding "AIDE found changed files on ${when}${detail:+ (${detail})}: review them with journalctl -u ${unit}, then accept them by rebuilding the database (aideinit --yes --force on Debian and Ubuntu, aide --init and moving aide.db.new.gz to aide.db.gz in /var/lib/aide on the RHEL family)."
			;;
		rkhunter)
			count=$(grep -c '^Warning:' <<<"${output}" || true)
			detail=$(grep -m 1 '^Warning:' <<<"${output}" | cut -c 10-120 || true)
			finding "rkhunter reported ${count} warning(s) on ${when}${detail:+, the first: ${detail}} (journalctl -u ${unit})."
			;;
		ClamAV)
			count=$(grep -c ' FOUND$' <<<"${output}" || true)
			detail=$(grep ' FOUND$' <<<"${output}" | head -n 3 | sed 's/: .* FOUND$//' | paste -sd ',' - | sed 's/,/, /g' || true)
			finding "ClamAV found ${count} infected file(s) on ${when}${detail:+: ${detail}} (journalctl -u ${unit})."
			;;
		*) ;;
		esac
	done
	return
}

check_lynis() {
	local minimum last
	minimum=$(setting GUARD_LYNIS_MIN 0)
	[[ -f ${STATE_DIR}/lynis-history ]] || return 0
	last=$(tail -n 1 "${STATE_DIR}/lynis-history" | awk '{ print $2 }')
	if [[ ${last} =~ ^[0-9]+$ ]] && ((last < minimum)); then
		finding "Lynis hardening index ${last} is below ${minimum}."
	fi
}

# Certificates below the TLS directory that expire within 14 days: certbot renews 30 days ahead, so this means the
# renewal fails (DNS, port 80, rate limit).
check_certificates() {
	local cert name end
	for cert in "${TLS_DIR}"/*/fullchain.pem; do
		[[ -f ${cert} ]] || continue
		if ! openssl x509 -checkend $((14 * 86400)) -noout -in "${cert}" >/dev/null 2>&1; then
			name=${cert%/fullchain.pem}
			name=${name##*/}
			end=$(openssl x509 -enddate -noout -in "${cert}" 2>/dev/null | cut -d '=' -f 2-)
			finding "Certificate ${name} expires ${end:-soon}; renewal does not work (journalctl -u certbot*)."
		fi
	done
	return
}

# images ENGINE: "ID REFERENCE" for every image of ENGINE, once per image; REFERENCE is repository:tag, or the ID for
# an image without a tag.
images() {
	local engine=$1 id repository tag
	"${engine}" images --format '{{.ID}} {{.Repository}} {{.Tag}}' 2>/dev/null |
		while read -r id repository tag; do
			[[ -n ${id} ]] || continue
			if [[ ${repository} == '<none>' || ${tag} == '<none>' || -z ${tag} ]]; then
				printf '%s %s\n' "${id}" "${id}"
			else
				printf '%s %s:%s\n' "${id}" "${repository}" "${tag}"
			fi
		done | awk '!seen[$1]++'
	return
}

# scan_image ENGINE ID REFERENCE: one line per HIGH or CRITICAL vulnerability of the image, its severity. Trivy reads
# Docker images through the daemon; a Podman image is saved to an archive first, which needs no socket.
scan_image() {
	local engine=$1 id=$2 ref=$3 tmp status=0
	# shellcheck disable=SC2016 # a Go template, not a shell expansion
	local -a scan=("${TRIVY}" image --cache-dir "${TRIVY_CACHE}" --scanners vuln --severity "HIGH,CRITICAL" --quiet
		--timeout 15m --format template --template '{{range .Results}}{{range .Vulnerabilities}}{{println .Severity}}{{end}}{{end}}')
	if [[ ${engine} == docker ]]; then
		"${scan[@]}" --image-src docker "${ref}"
		return
	fi
	tmp=$(mktemp -d)
	if podman image save --quiet -o "${tmp}/image.tar" "${id}" >/dev/null 2>&1; then
		"${scan[@]}" --input "${tmp}/image.tar" || status=$?
	else
		status=1
	fi
	rm -rf -- "${tmp}"
	return "${status}"
}

# Container images with known HIGH or CRITICAL vulnerabilities: one finding per image with the numbers. An image Trivy
# cannot scan (no network for its database, a broken image) is a note.
check_containers() {
	local engine id ref output high critical
	[[ -x ${TRIVY} ]] || return 0
	for engine in docker podman; do
		command -v "${engine}" >/dev/null 2>&1 || continue
		while read -r id ref; do
			if ! output=$(scan_image "${engine}" "${id}" "${ref}" 2>/dev/null); then
				note "Trivy could not scan the ${engine} image ${ref}."
				continue
			fi
			critical=$(grep -c '^CRITICAL$' <<<"${output}" || true)
			high=$(grep -c '^HIGH$' <<<"${output}" || true)
			if ((critical + high > 0)); then
				finding "The ${engine} image ${ref} has ${critical} critical and ${high} high vulnerabilities (trivy image ${ref}); update the image."
			fi
		done < <(images "${engine}")
	done
	return
}

# backup_stamp NAME: a time or result the backup script recorded (libexec/lss-backup); nothing when it never did.
backup_stamp() {
	local file=${BACKUP_STATE}/$1 value=''
	[[ -f ${file} ]] && value=$(<"${file}")
	[[ ${value} =~ ^[0-9]+$ ]] && printf '%s' "${value}"
	return 0
}

# The restic backup (when the restic module is installed): the last successful backup must be younger than
# GUARD_BACKUP_MAX_AGE hours (counted from the installation until the first one), and once a week a restore test
# proves that the latest backup comes back.
check_backup() {
	local max now last installed age tested
	[[ -x ${BACKUP} ]] || return 0
	max=$(setting GUARD_BACKUP_MAX_AGE 30)
	now=$(date +%s)
	last=$(backup_stamp last-success)
	if [[ -z ${last} ]]; then
		installed=$(sed -n 's/^installed_at=//p' "${STATE_DIR}/modules/restic" 2>/dev/null || true)
		last=$(date -d "${installed:-now}" +%s 2>/dev/null || printf '%s' "${now}")
	fi
	age=$(((now - last) / 3600))
	if ((age >= max)); then
		finding "The last successful backup is ${age} hours old, more than ${max} (journalctl -u lss-backup)."
	fi
	[[ -n $(backup_stamp last-success) ]] || return 0
	tested=$(backup_stamp restore-test)
	if [[ -z ${tested} ]] || ((now - tested >= RESTORE_TEST_INTERVAL)); then
		if "${BACKUP}" restore-test >/dev/null 2>&1; then
			logger -t lss-guard -p auth.info -- "Backup restore test passed"
		else
			finding "The weekly restore test of the backup failed (${BACKUP} restore-test shows why)."
		fi
	elif [[ $(backup_stamp restore-test-success) == 0 ]]; then
		finding "The last restore test of the backup failed (${BACKUP} restore-test shows why)."
	fi
	return
}

# export_metrics: the result of this run for Prometheus, through the node exporter's textfile collector.
export_metrics() {
	local file=${TEXTFILE_DIR}/lss_guard.prom
	[[ -d ${TEXTFILE_DIR} ]] || return 0
	{
		printf '# HELP lss_guard_findings Findings of the last lss guard run.\n# TYPE lss_guard_findings gauge\n'
		printf 'lss_guard_findings %s\n' "${#FINDINGS[@]}"
		printf '# HELP lss_guard_fixed Modules the last lss guard run restored.\n# TYPE lss_guard_fixed gauge\n'
		printf 'lss_guard_fixed %s\n' "${#FIXED[@]}"
		printf '# HELP lss_guard_notes Notes of the last lss guard run.\n# TYPE lss_guard_notes gauge\n'
		printf 'lss_guard_notes %s\n' "${#NOTES[@]}"
		printf '# HELP lss_guard_last_run_timestamp_seconds End of the last lss guard run.\n'
		printf '# TYPE lss_guard_last_run_timestamp_seconds gauge\nlss_guard_last_run_timestamp_seconds %s\n' "$(date +%s)"
	} >"${file}.tmp"
	chmod 0644 "${file}.tmp"
	mv -f -- "${file}.tmp" "${file}"
	return
}

json_escape() {
	local text=$1
	text=${text//\\/\\\\}
	text=${text//\"/\\\"}
	text=${text//$'\n'/\\n}
	text=${text//$'\t'/\\t}
	text=${text//$'\r'/}
	printf '%s' "${text}"
	return
}

notify() {
	local summary=$1 webhook email body
	webhook=$(setting GUARD_WEBHOOK)
	email=$(setting GUARD_EMAIL)
	if [[ -n ${webhook} ]]; then
		if [[ ${webhook} == *ntfy* ]]; then
			body=${summary}
		else
			# "text" for Slack, Teams and Mattermost, "content" for Discord.
			body="{\"text\":\"$(json_escape "${summary}")\",\"content\":\"$(json_escape "${summary:0:1900}")\"}"
		fi
		curl --fail --silent --show-error --proto '=https' --tlsv1.2 --max-time 20 \
			-H 'Content-Type: application/json' --data-binary @- "${webhook}" <<<"${body}" >/dev/null ||
			logger -t lss-guard -p auth.err -- "Webhook delivery failed"
	fi
	if [[ -n ${email} ]] && command -v sendmail >/dev/null 2>&1; then
		printf 'To: %s\nSubject: [lss guard] %s\n\n%s\n' "${email}" "$(hostname -f 2>/dev/null || hostname)" "${summary}" |
			sendmail -t -i || logger -t lss-guard -p auth.err -- "Mail delivery failed"
	fi
	return
}

main() {
	[[ ${EUID} -eq 0 ]] || {
		echo "lss guard must run as root." >&2
		exit 1
	}
	check_modules
	check_units
	check_disks
	check_updates
	check_vulnerabilities
	check_logins
	check_bans
	check_scanners
	check_lynis
	check_certificates
	check_containers
	check_backup
	export_metrics
	local summary host
	host=$(hostname -f 2>/dev/null || hostname)
	if [[ ${#FINDINGS[@]} -eq 0 && ${#FIXED[@]} -eq 0 ]]; then
		logger -t lss-guard -p auth.info -- "All checks passed"
		if [[ $(setting GUARD_DAILY_SUMMARY false) == true ]]; then
			summary="lss guard on ${host}: all checks passed."
			local line
			for line in "${NOTES[@]}"; do summary+=$'\n'"- ${line}"; done
			notify "${summary}"
		fi
		return 0
	fi
	summary="lss guard on ${host}:"
	local line
	for line in "${FINDINGS[@]}"; do summary+=$'\n'"- ${line}"; done
	for line in "${FIXED[@]}"; do summary+=$'\n'"- Restored module ${line} (it had been changed outside lss)."; done
	for line in "${NOTES[@]}"; do summary+=$'\n'"- ${line}"; done
	notify "${summary}"
	[[ ${#FINDINGS[@]} -eq 0 ]]
}

# The unit tests source this file without running it.
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
	main "$@"
fi
