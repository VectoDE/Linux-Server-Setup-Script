# The unit tests under bash 5.1 (.github/workflows/ci.yml, job "Unit tests, bash"). The official image is Alpine with
# bash built from source in /usr/local/bin, first in PATH; the other tools the tests call come from Alpine, as GNU
# tools like on the supported systems. None of these packages pulls in Alpine's own bash.
FROM bash:5.1@sha256:13d6dacba3442056074ae27b71227835a5cc81566873800fe740373a55c8fb7a

RUN apk add --no-cache coreutils diffutils file findutils gawk gettext git grep gzip jq ncurses openssl \
		openssh-keygen perl procps-ng python3 sed tar tzdata unzip util-linux xz \
	&& [ "$(command -v bash)" = /usr/local/bin/bash ]
