# pacman stub: "-T PACKAGE" succeeds for packages listed in $STUB_INSTALLED; every other command is recorded and exits
# with $STUB_EXIT_pacman (default 0).
if [[ $1 == -T ]]; then
	printf 'pacman %s\n' "$*" >>"${STUB_LOG:-/dev/null}"
	[[ " ${STUB_INSTALLED:-} " == *" ${*: -1} "* ]]
	exit
fi
# shellcheck source=tests/fixtures/bin/_stub.bash
source "$(dirname "$0")/_stub.bash"
stub_main pacman "$@"
