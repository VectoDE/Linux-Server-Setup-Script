# certbot stub: records the call, with the CA bundle certbot was told to trust, and exits with $STUB_EXIT_certbot.
printf 'certbot %s%s\n' "${REQUESTS_CA_BUNDLE:+REQUESTS_CA_BUNDLE=${REQUESTS_CA_BUNDLE} }" "$*" >>"${STUB_LOG:-/dev/null}"
exit "${STUB_EXIT_certbot:-0}"
