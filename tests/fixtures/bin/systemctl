# systemctl stub: "is-active UNIT" and "is-enabled UNIT" succeed for units listed in $STUB_ACTIVE_UNITS.
printf 'systemctl %s\n' "$*" >>"${STUB_LOG:-/dev/null}"
case $1 in
is-active | is-enabled)
	unit=${*: -1}
	[[ " ${STUB_ACTIVE_UNITS:-} " == *" ${unit} "* ]]
	exit
	;;
list-unit-files)
	[[ " ${STUB_ACTIVE_UNITS:-} " == *" $3 "* ]] && printf '%s enabled\n' "$3"
	exit 0
	;;
*) exit 0 ;;
esac
