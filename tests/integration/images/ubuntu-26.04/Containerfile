# ubuntu-26.04 with systemd as PID 1, the way a minimal cloud server boots (no policy-rc.d, which
# stops services from starting in Docker images). Used by tests/integration/run.sh.
FROM ubuntu:26.04@sha256:f144425ff09be612d6d9ad965196e9cdc23dae1f42110a8a11a3e9a8198759f7

RUN apt-get update -q \
	&& DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends \
		ca-certificates cron curl dbus gnupg iproute2 openssh-server procps rsyslog sudo systemd systemd-sysv \
	&& rm -rf /var/lib/apt/lists/* \
	&& rm -f /usr/sbin/policy-rc.d /lib/systemd/system/multi-user.target.wants/getty* /etc/systemd/system/getty.target.wants/*

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
