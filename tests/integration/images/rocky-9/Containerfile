# rocky-9 with systemd as PID 1, the way a minimal cloud server boots. Used by tests/integration/run.sh.
FROM rockylinux/rockylinux:9@sha256:8101994123cf3d0a8fee517bee7f39e555c7d92bd2d9eb3303cc988a0eeed00f

RUN dnf -y -q --allowerasing install \
		ca-certificates cronie curl dbus gnupg2 iproute openssh-server policycoreutils procps-ng sudo systemd tar which \
	&& dnf clean all

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
