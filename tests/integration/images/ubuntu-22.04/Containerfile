# ubuntu-22.04 with systemd as PID 1, the way a minimal cloud server boots. Used by tests/integration/run.sh.
FROM ubuntu:22.04@sha256:5ec03bb3441e8b0bf3b4f9cd4629a1ae763010dc3035bb8da3ae6cf026486401

RUN apt-get update -q \
	&& DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends \
		systemd systemd-sysv dbus ca-certificates curl gnupg iproute2 procps openssh-server sudo cron rsyslog \
	&& rm -rf /var/lib/apt/lists/* \
	&& rm -f /lib/systemd/system/multi-user.target.wants/getty* /etc/systemd/system/getty.target.wants/*

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
