# almalinux-10 with systemd as PID 1, the way a minimal cloud server boots. Used by tests/integration/run.sh.
FROM almalinux:10@sha256:838c2fafefb1a8a0d7f8cdbc3b0551c2a2b1eb0cd87aad6d62aecadb18311f1b

RUN dnf -y -q --allowerasing install \
		ca-certificates cronie curl dbus gnupg2 iproute openssh-server policycoreutils procps-ng sudo systemd tar which \
	&& dnf clean all

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
